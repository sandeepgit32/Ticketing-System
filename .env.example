# Optional: Set your Mailtrap credentials for email notifications
# Sign up at https://mailtrap.io/ to get these credentials
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# JWT Secret Key (change this in production!)
JWT_SECRET_KEY=your-secret-key-change-in-production

# MySQL Configuration (default values from docker-compose)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=ticketing
MYSQL_USER=ticketuser
MYSQL_PASSWORD=ticketpass
