# -----------------------------------------------------------------------
# Razorpay Payment Provider — environment variable template
# Copy this file to .env and fill in the values for your environment.
# -----------------------------------------------------------------------

# Razorpay API key ID (public). Found in Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay API key secret (private). Never expose this to the frontend.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook signing secret. YOU choose this value and enter it in two places:
#   1. Here in .env
#   2. Razorpay Dashboard → Settings → Webhooks → Secret (when adding your webhook URL)
# Razorpay will then sign every outbound webhook call with this secret so the
# service can verify the X-Razorpay-Signature header.
#
# For local development without a Razorpay account, any non-empty string works —
# Razorpay cannot reach localhost so this endpoint is never called externally.
# Generate a strong value for production: openssl rand -hex 32
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Shared HMAC-SHA256 secret used to sign outbound webhooks to the booking service.
# Must match the WEBHOOK_SECRET configured in the booking service.
WEBHOOK_SECRET=your-shared-webhook-secret-here

# Full URL of the booking service webhook receiver.
BOOKING_WEBHOOK_URL=http://booking:8000/payments/webhook

# Redis connection URL for idempotency key storage and payment deduplication.
REDIS_URL=redis://redis:6379/0
