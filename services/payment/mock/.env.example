# -----------------------------------------------------------------------
# Mock Payment Provider — environment variable template
# Copy this file to .env and fill in values for your local environment.
# -----------------------------------------------------------------------

# Shared HMAC-SHA256 secret used to sign outbound webhook payloads.
# The booking service must be configured with the same value to verify
# webhook authenticity via the X-Signature header.
WEBHOOK_SECRET=your-webhook-secret-here

# Full URL of the booking service endpoint that receives payment events.
# Override this when running services on non-default ports or hostnames.
BOOKING_WEBHOOK_URL=http://booking:8000/payments/webhook

# Redis connection URL for storing payment intents and idempotency keys.
REDIS_URL=redis://redis:6379/0