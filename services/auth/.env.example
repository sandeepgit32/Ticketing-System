# Example .env for auth service
# Copy this file to .env and set real values

# JWT configuration
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database configuration
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=ticketuser
MYSQL_PASSWORD=
MYSQL_DATABASE=ticketing

# Default admin account seeded on auth service startup
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULL_NAME=System Admin
