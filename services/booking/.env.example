# Example environment variables for the booking service.
# Copy this file to .env and adjust values for your environment.

# Redis: used for in-flight reservation locking / TTL storage
REDIS_URL=redis://redis:6379/0

# MySQL connection configuration
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=ticketuser
MYSQL_PASSWORD=ticketpass
MYSQL_DATABASE=ticketing

# Payment provider base URL (used by /payments/capture)
PAYMENT_PROVIDER_URL=http://payment-mock:8000

# Booking behavior tunables
RESERVATION_TTL_SECONDS=600
