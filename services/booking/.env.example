# Example environment variables for the booking service.
# Copy this file to .env and adjust values for your environment.

# Redis: used for in-flight reservation locking / TTL storage
REDIS_URL=redis://redis:6379/0

# MySQL connection configuration
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=ticketuser
MYSQL_PASSWORD=ticketpass
MYSQL_DATABASE=ticketing

# Payment provider base URL (used by /payments/capture and /payments/confirm).
# For the mock provider:    http://payment-mock:8000
# For the Razorpay provider: http://payment-razorpay:9000
PAYMENT_PROVIDER_URL=http://payment-mock:8000

# Shared HMAC-SHA256 secret used to verify inbound webhooks from the payment service.
# Must match the WEBHOOK_SECRET set in services/payment/razorpay/.env (or the mock .env).
# Choose any strong random string — e.g.: openssl rand -hex 32
WEBHOOK_SECRET=your-shared-webhook-secret-here

# Booking behavior tunables
RESERVATION_TTL_SECONDS=600
