# Gateway service environment variables

AUTH_SERVICE_URL=http://auth:8000
BOOKING_SERVICE_URL=http://booking:8000
BOOKING_STATUS_SERVICE_URL=http://booking-status:8000

# Payment provider switch — set to one of the two options below:
#   Mock (local dev, no Razorpay account needed): http://payment-mock:8000
#   Razorpay (real payments):                     http://payment-razorpay:8000
PAYMENT_SERVICE_URL=http://payment-mock:8000

# Frontend origins allowed by CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
